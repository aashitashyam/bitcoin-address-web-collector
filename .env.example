# Copy this file to .env and fill in real values. .env is loaded automatically.

# --- Postgres ---
BTC_DB_HOST=localhost
BTC_DB_PORT=5432
BTC_DB_NAME=btc_collector
BTC_DB_USER=btc_collector
BTC_DB_PASSWORD=changeme

# --- Crawler behavior ---
BTC_CRAWLER_UA=BitcoinAddressResearchCrawler/1.0 (+academic research project; contact: you@example.com)
BTC_REQUEST_TIMEOUT=20
BTC_CRAWL_DELAY=2.0
BTC_MAX_DEPTH=4
BTC_RESPECT_ROBOTS=true
BTC_REVISIT_HOURS=48

# --- Bitcoin Core RPC enrichment (optional) ---
BTC_RPC_ENABLED=false
BTC_RPC_HOST=127.0.0.1
BTC_RPC_PORT=8332
BTC_RPC_USER=
BTC_RPC_PASSWORD=
